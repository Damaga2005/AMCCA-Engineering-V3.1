{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amcca://schema/referral/3.1.0",
  "title": "Referral link",
  "description": "A referral usable in content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "referral_id",
    "program_id",
    "state",
    "validation_method",
    "validated_at",
    "disclosure_required",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0",
      "description": "Contract version. Required on every persisted object (D-004)."
    },
    "referral_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
    },
    "program_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
    },
    "production_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "brand": {
      "type": "string",
      "maxLength": 200
    },
    "code": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "BLOCKED",
        "REVIEW",
        "UNVERIFIED",
        "DISCOVERED"
      ]
    },
    "validation_method": {
      "enum": [
        "OFFICIAL_API",
        "OFFICIAL_DASHBOARD",
        "OPERATOR_VERIFIED",
        "HTTP_CHECK",
        "MANUAL_CONFIRMATION"
      ]
    },
    "validation_evidence_ref": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "validated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
        },
        {
          "type": "null"
        }
      ]
    },
    "commission_model": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "geo_restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "platform_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclosure_required": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ACTIVE"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "validation_method": {
            "enum": [
              "OFFICIAL_API",
              "OFFICIAL_DASHBOARD",
              "OPERATOR_VERIFIED",
              "MANUAL_CONFIRMATION"
            ]
          }
        },
        "required": [
          "validation_evidence_ref"
        ]
      },
      "$comment": "AFFILIATE_POLICY: a 200 OK is not proof of validity. HTTP_CHECK cannot sustain ACTIVE."
    }
  ]
}
