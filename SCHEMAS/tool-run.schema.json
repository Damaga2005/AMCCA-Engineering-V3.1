{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amcca://schema/tool-run/3.1.0",
  "title": "Tool invocation record",
  "description": "One tool invocation. EXTERNAL_UNSAFE tools must carry intent_id and idempotency_key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "tool_id",
    "tool_version",
    "state",
    "side_effect_class",
    "correlation_id",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0",
      "description": "Contract version. Required on every persisted object (D-004)."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
    },
    "production_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "job_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_run_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "side_effect_class": {
      "enum": [
        "PURE",
        "READ",
        "LOCAL_WRITE",
        "EXTERNAL_IDEMPOTENT",
        "EXTERNAL_UNSAFE"
      ]
    },
    "state": {
      "enum": [
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "TIMED_OUT",
        "UNKNOWN_EXTERNAL_STATE"
      ]
    },
    "intent_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_hash": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
    },
    "causation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
    },
    "finished_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "side_effect_class": {
            "const": "EXTERNAL_UNSAFE"
          }
        },
        "required": [
          "side_effect_class"
        ]
      },
      "then": {
        "required": [
          "intent_id",
          "idempotency_key"
        ],
        "properties": {
          "intent_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          }
        }
      },
      "$comment": "Invariant I-03: every external mutation has a persisted intent before the call."
    }
  ]
}
