{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amcca://schema/production/3.1.0",
  "title": "Production",
  "description": "The central aggregate. All other evidence-plane and business-plane records reference it by production_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "state",
    "autonomy_mode",
    "language",
    "created_at",
    "updated_at",
    "aggregate_version"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0",
      "description": "Contract version. Required on every persisted object (D-004)."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
    },
    "state": {
      "enum": [
        "INIT",
        "RESEARCHING",
        "RESEARCH_VERIFIED",
        "CONCEPT_SELECTED",
        "SCRIPTING",
        "SCRIPT_VERIFIED",
        "STORYBOARDING",
        "STORYBOARD_VERIFIED",
        "ASSET_GENERATION",
        "ASSETS_READY",
        "AUDIO_GENERATION",
        "AUDIO_READY",
        "EDITING",
        "CANDIDATE_RENDERED",
        "TECHNICAL_QA",
        "VISUAL_QA",
        "AUDIO_QA",
        "CONTENT_QA",
        "RETENTION_QA",
        "COMPLIANCE_QA",
        "SCORING",
        "REWORK",
        "FINAL_VERIFIED",
        "READY_TO_PUBLISH",
        "PUBLISHING",
        "PUBLICATION_PROCESSING",
        "PUBLICATION_VERIFIED",
        "ARCHIVED",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN_EXTERNAL_STATE"
      ],
      "description": "Canonical production state. The enum is generated from the same canonical model as SCHEMAS/state-machine.json; the two cannot drift."
    },
    "blocked_from": {
      "oneOf": [
        {
          "enum": [
            "INIT",
            "RESEARCHING",
            "RESEARCH_VERIFIED",
            "CONCEPT_SELECTED",
            "SCRIPTING",
            "SCRIPT_VERIFIED",
            "STORYBOARDING",
            "STORYBOARD_VERIFIED",
            "ASSET_GENERATION",
            "ASSETS_READY",
            "AUDIO_GENERATION",
            "AUDIO_READY",
            "EDITING",
            "CANDIDATE_RENDERED",
            "TECHNICAL_QA",
            "VISUAL_QA",
            "AUDIO_QA",
            "CONTENT_QA",
            "RETENTION_QA",
            "COMPLIANCE_QA",
            "SCORING",
            "REWORK",
            "FINAL_VERIFIED",
            "READY_TO_PUBLISH",
            "PUBLISHING",
            "PUBLICATION_PROCESSING",
            "PUBLICATION_VERIFIED",
            "ARCHIVED",
            "BLOCKED",
            "FAILED",
            "CANCELLED",
            "UNKNOWN_EXTERNAL_STATE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "unknown_from": {
      "oneOf": [
        {
          "enum": [
            "INIT",
            "RESEARCHING",
            "RESEARCH_VERIFIED",
            "CONCEPT_SELECTED",
            "SCRIPTING",
            "SCRIPT_VERIFIED",
            "STORYBOARDING",
            "STORYBOARD_VERIFIED",
            "ASSET_GENERATION",
            "ASSETS_READY",
            "AUDIO_GENERATION",
            "AUDIO_READY",
            "EDITING",
            "CANDIDATE_RENDERED",
            "TECHNICAL_QA",
            "VISUAL_QA",
            "AUDIO_QA",
            "CONTENT_QA",
            "RETENTION_QA",
            "COMPLIANCE_QA",
            "SCORING",
            "REWORK",
            "FINAL_VERIFIED",
            "READY_TO_PUBLISH",
            "PUBLISHING",
            "PUBLICATION_PROCESSING",
            "PUBLICATION_VERIFIED",
            "ARCHIVED",
            "BLOCKED",
            "FAILED",
            "CANCELLED",
            "UNKNOWN_EXTERNAL_STATE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rework_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 0
    },
    "autonomy_mode": {
      "enum": [
        "MANUAL",
        "ASSISTED",
        "AUTONOMOUS"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "niche_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "opportunity_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "current_manifest_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID, generated locally. External identifiers are never primary keys (D-003)."
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC with explicit offset. format:date-time is enforced by FormatChecker at every validation call site (V31-02); it is not merely declared."
    }
  }
}
